# OpenAI-compatible Chat Completions endpoint
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=llama.cpp
OPENAI_MODEL=llama.cpp
OPENAI_INPUT=text,image
OPENAI_CONTEXT_WINDOW=262144
# Request + socket-idle timeout in milliseconds (0 = disabled).
OPENAI_TIMEOUT_MS=0

# Permission modes: auto, ask, or off. Defaults: terminal ask, skills/MCP off.
TERMINAL_MODE=off
SKILLS_MODE=off
MCP_MODE=off
